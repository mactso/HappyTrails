{
  "schemaVersion": 1,
  "id": "happytrails",
  "version": "${version}",

  "name": "Happy Trails",
  "description": "Control Movement Speed on various Minecraft Blocks",
  "authors": [
    "Mactso, Lupicus"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/experience-bug-fix",
    "sources": "https://github.com/mactso/HappyTrails",
    "issues": "https://github.com/mactso/HappyTrails/issues"
  },

  "license": "MIT License",
  "icon": "Logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mactso.happytrails.Main"
    ]
  },
  "mixins": [
    "happytrails.mixins.json"
  ],

  "depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}